generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma2"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(store_owner)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  stores       Store[]
  classLevel   Int?     @map("class_level")
  children     StudentProfile[]
  affiliateCode AffiliateCode?
  marketplaceItems MarketplaceItem[]

  @@map("users")
}

model Store {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  subdomain              String?        @unique
  customDomain           String?        @unique @map("custom_domain")
  siteType               SiteType       @default(storefront) @map("site_type")
  name                   String
  logoUrl                String?        @map("logo_url")
  bannerUrl              String?        @map("banner_url")
  themeColor             String         @default("#16a34a") @map("theme_color")
  fontStyle              String?        @map("font_style")
  templateId             String?        @map("template_id")
  layoutType             String?        @map("layout_type")
  ownerId                String         @map("owner_id")
  planType               PlanType       @default(basic) @map("plan_type")
  status                 StoreStatus    @default(trial)
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  industry               String?        @map("industry")
  googleSiteVerification String?        @map("google_site_verification")
  seoDescription         String?        @map("seo_description")
  seoImage               String?        @map("seo_image")
  seoTitle               String?        @map("seo_title")
  targetAudience         String?        @map("target_audience")
  faviconUrl             String?        @map("favicon_url")
  articles               Article[]
  categories             Category[]
  customers              Customer[]
  orders                 Order[]
  products               Product[]
  pages                  StorePage[]
  settings               StoreSettings?
  owner                  User           @relation(fields: [ownerId], references: [id])

  @@index([ownerId])
  @@map("stores")
}

model StorePage {
  id             String   @id @default(cuid())
  storeId        String   @map("store_id")
  pageType       PageType @default(home) @map("page_type")
  slug           String?
  title          String?
  blocks         Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  seoDescription String?  @map("seo_description")
  seoImage       String?  @map("seo_image")
  seoTitle       String?  @map("seo_title")
  html           String   @default("") @map("html")
  briefJson      Json?    @map("brief_json")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_pages")
}

model StoreSettings {
  id                     String   @id @default(cuid())
  storeId                String   @unique @map("store_id")
  whatsappNumber         String?  @map("whatsapp_number")
  bankAccounts           Json?    @map("bank_accounts")
  shippingOriginCity     String?  @map("shipping_origin_city")
  shippingOriginProvince String?  @map("shipping_origin_province")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  flatShippingCost       Decimal  @default(0) @map("flat_shipping_cost") @db.Decimal(12, 2)
  midtransClientKey      String?  @map("midtrans_client_key")
  midtransIsProduction   Boolean  @default(false) @map("midtrans_is_production")
  midtransServerKey      String?  @map("midtrans_server_key")
  qrisImageUrl           String?  @map("qris_image_url")
  whatsappApiKey         String?  @map("whatsapp_api_key")
  whatsappApiKeyHeader   String   @default("Authorization") @map("whatsapp_api_key_header")
  whatsappApiKeyPrefix   String   @default("") @map("whatsapp_api_key_prefix")
  whatsappApiUrl         String?  @map("whatsapp_api_url")
  whatsappMessageField   String   @default("message") @map("whatsapp_message_field")
  whatsappTargetField    String   @default("target") @map("whatsapp_target_field")
  headerMenus            Json?    @map("header_menus")
  useFavicon             Boolean  @default(true) @map("use_favicon")
  useGlobalHeader        Boolean  @default(true) @map("use_global_header")
  useLogo                Boolean  @default(true) @map("use_logo")
  store                  Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_settings")
}

model Category {
  id        String    @id @default(cuid())
  storeId   String    @map("store_id")
  name      String
  slug      String
  createdAt DateTime  @default(now()) @map("created_at")
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id             String           @id @default(cuid())
  storeId        String           @map("store_id")
  name           String
  slug           String
  description    String?
  price          Decimal          @db.Decimal(12, 2)
  stock          Int              @default(0)
  categoryId     String?          @map("category_id")
  status         ProductStatus    @default(draft)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  seoDescription String?          @map("seo_description")
  seoImage       String?          @map("seo_image")
  seoTitle       String?          @map("seo_title")
  orderItems     OrderItem[]
  images         ProductImage[]
  variants       ProductVariant[]
  category       Category?        @relation(fields: [categoryId], references: [id])
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String      @map("product_id")
  name          String
  priceOverride Decimal?    @map("price_override") @db.Decimal(12, 2)
  stock         Int         @default(0)
  orderItems    OrderItem[]
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  url       String
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  name      String
  phone     String
  email     String?
  address   Json?
  createdAt DateTime @default(now()) @map("created_at")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([storeId])
  @@map("customers")
}

model Order {
  id                    String      @id @default(cuid())
  storeId               String      @map("store_id")
  customerId            String?     @map("customer_id")
  orderNumber           String      @unique @map("order_number")
  status                OrderStatus @default(pending)
  subtotal              Decimal     @db.Decimal(12, 2)
  shippingCost          Decimal     @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  total                 Decimal     @db.Decimal(12, 2)
  shippingAddress       Json?       @map("shipping_address")
  paymentMethod         String?     @map("payment_method")
  midtransTransactionId String?     @map("midtrans_transaction_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  items                 OrderItem[]
  customer              Customer?   @relation(fields: [customerId], references: [id])
  store                 Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payments              Payment[]

  @@index([storeId])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String          @map("order_id")
  productId String          @map("product_id")
  variantId String?         @map("variant_id")
  qty       Int
  price     Decimal         @db.Decimal(12, 2)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id         String    @id @default(cuid())
  orderId    String    @map("order_id")
  provider   String    @default("midtrans")
  status     String
  rawPayload Json?     @map("raw_payload")
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

model AiProvider {
  id        String   @id @default(cuid())
  provider  String   @map("provider")
  baseUrl   String   @map("base_url")
  apiKey    String   @map("api_key")
  model     String
  isActive  Boolean  @default(true) @map("is_active")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_providers")
}

model Article {
  id             String        @id @default(cuid())
  storeId        String        @map("store_id")
  title          String
  slug           String
  content        String
  excerpt        String?
  thumbnail      String?
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description")
  status         ProductStatus @default(draft)
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  store          Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("articles")
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  modules   Module[]

  @@map("subjects")
}

model Module {
  id          String     @id @default(cuid())
  subjectId   String     @map("subject_id")
  gradeLevel  Int
  title       String
  slug        String
  description String?
  isPublished Boolean    @default(false) @map("is_published")
  isPremium   Boolean    @default(false) @map("is_premium")
  price       Decimal?   @db.Decimal(12, 2)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions   Question[]
  progress    StudentProgress[]
  moduleAccesses ModuleAccess[]

  @@unique([subjectId, slug])
  @@map("modules")
}

model Question {
  id           String   @id @default(cuid())
  moduleId     String   @map("module_id")
  difficultyLevel Int   @default(1) @map("difficulty_level")
  questionText String   @map("question_text")
  options      Json
  correctIndex Int      @map("correct_index")
  explanation  String?
  createdAt    DateTime @default(now()) @map("created_at")
  module       Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("questions")
}

enum Role {
  super_admin
  store_owner
  customer
  operator
}

enum SiteType {
  company_profile
  landing_page
  sales_page
  storefront
}

enum PlanType {
  basic
  business
  pro
  enterprise
}

enum StoreStatus {
  active
  suspended
  trial
}

enum ProductStatus {
  draft
  published
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  completed
  cancelled
}

enum PageType {
  home
  about
  contact
  custom
}

enum EduRole {
  teacher
  student
}

model StudentProfile {
  id         String   @id @default(cuid())
  parentId   String   @map("parent_id")
  name       String
  gradeLevel Int      @map("grade_level")
  starsBalance Int    @default(0) @map("stars_balance")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  parent     User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  progress   StudentProgress[]
  moduleAccesses ModuleAccess[]
  rewardClaims   RewardClaim[]

  @@index([parentId])
  @@map("student_profiles")
}

model StudentProgress {
  id          String    @id @default(cuid())
  studentId   String    @map("student_id")
  moduleId    String    @map("module_id")
  score       Int       @default(0)
  currentLevel Int      @default(1) @map("current_level")
  isCompleted Boolean   @default(false) @map("is_completed")
  unlockedAt  DateTime  @default(now()) @map("unlocked_at")
  completedAt DateTime? @map("completed_at")
  
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module      Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@index([moduleId])
  @@map("student_progress")
}

// ─── System & Payment Settings ───────────────────────────────────────────────

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ─── Discount Codes ──────────────────────────────────────────────────────────

model DiscountCode {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  type        DiscountType @default(percentage)
  discountPct Decimal?  @map("discount_pct") @db.Decimal(5, 2)
  discountAmt Decimal?  @map("discount_amt") @db.Decimal(12, 2)
  minOrder    Decimal?  @map("min_order")    @db.Decimal(12, 2)
  maxUses     Int?      @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  expiresAt   DateTime? @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("discount_codes")
}

// ─── Affiliate Codes ─────────────────────────────────────────────────────────

model AffiliateCode {
  id                String            @id @default(cuid())
  code              String            @unique
  ownerName         String            @map("owner_name")
  ownerEmail        String?           @map("owner_email")
  ownerPhone        String?           @map("owner_phone")
  userId            String?           @unique @map("user_id")
  commissionPct     Decimal           @map("commission_pct") @db.Decimal(5, 2)
  totalConversions  Int               @default(0) @map("total_conversions")
  totalEarnings     Decimal           @default(0) @map("total_earnings") @db.Decimal(14, 2)
  pendingBalance    Decimal           @default(0) @map("pending_balance") @db.Decimal(14, 2)
  paidOut           Decimal           @default(0) @map("paid_out") @db.Decimal(14, 2)
  bankName          String?           @map("bank_name")
  bankAccountNumber String?           @map("bank_account_number")
  bankAccountName   String?           @map("bank_account_name")
  status            AffiliateStatus   @default(pending_review)
  isActive          Boolean           @default(true) @map("is_active")
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user        User?                  @relation(fields: [userId], references: [id])
  withdrawals AffiliateWithdrawal[]

  @@map("affiliate_codes")
}

model AffiliateWithdrawal {
  id          String             @id @default(cuid())
  affiliateId String             @map("affiliate_id")
  amount      Decimal            @db.Decimal(14, 2)
  status      WithdrawalStatus   @default(pending)
  notes       String?
  processedAt DateTime?          @map("processed_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  affiliate AffiliateCode @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@map("affiliate_withdrawals")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum DiscountType {
  percentage
  fixed
}

enum AffiliateStatus {
  pending_review
  active
  suspended
}

enum WithdrawalStatus {
  pending
  approved
  rejected
}

// ─── Gamification & Rewards ──────────────────────────────────────────────────

model ModuleAccess {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  moduleId  String   @map("module_id")
  unlockMethod String @default("stars") @map("unlock_method") // "stars" | "payment"
  createdAt DateTime @default(now()) @map("created_at")
  
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  module    Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([studentId, moduleId])
  @@index([studentId])
  @@index([moduleId])
  @@map("module_accesses")
}

model MarketplaceItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Int      // Price in stars
  imageUrl    String?  @map("image_url")
  creatorId   String   @map("creator_id") // Parent User ID or Admin User ID
  isGlobal    Boolean  @default(false) @map("is_global") // If true, available to all students
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  claims      RewardClaim[]

  @@index([creatorId])
  @@map("marketplace_items")
}

model RewardClaim {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  itemId    String   @map("item_id")
  status    ClaimStatus @default(pending) // pending, fulfilled, rejected
  claimedAt DateTime @default(now()) @map("claimed_at")
  fulfilledAt DateTime? @map("fulfilled_at")

  student   StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  item      MarketplaceItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([itemId])
  @@map("reward_claims")
}

enum ClaimStatus {
  pending
  fulfilled
  rejected
}
