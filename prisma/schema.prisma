generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  super_admin
  operator
  store_owner
  customer
}

enum SiteType {
  company_profile
  landing_page
  sales_page
  storefront
}

enum PlanType {
  basic
  business
  pro
  enterprise
}

enum StoreStatus {
  active
  suspended
  trial
}

enum ProductStatus {
  draft
  published
}

enum OrderStatus {
  pending
  paid
  processing
  shipped
  completed
  cancelled
}

enum PageType {
  home
  about
  contact
  custom
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(store_owner)
  stores       Store[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Store {
  id           String      @id @default(cuid())
  slug         String      @unique
  subdomain    String?     @unique
  customDomain String?     @unique @map("custom_domain")
  siteType     SiteType    @default(storefront) @map("site_type")
  name         String
  logoUrl      String?     @map("logo_url")
  bannerUrl    String?     @map("banner_url")
  themeColor   String      @default("#16a34a") @map("theme_color")
  fontStyle    String?     @map("font_style")
  templateId   String?     @map("template_id")
  layoutType   String?     @map("layout_type")
  industry     String?     @map("industry")
  targetAudience String?   @map("target_audience")
  ownerId      String      @map("owner_id")
  owner        User        @relation(fields: [ownerId], references: [id])
  planType     PlanType    @default(basic) @map("plan_type")
  status       StoreStatus @default(trial)

  // SEO Fields
  seoTitle               String?  @map("seo_title")
  seoDescription         String?  @map("seo_description")
  seoImage               String?  @map("seo_image")
  googleSiteVerification String?  @map("google_site_verification")

  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  pages      StorePage[]
  settings   StoreSettings?
  products   Product[]
  categories Category[]
  customers  Customer[]
  orders     Order[]
  articles   Article[]

  @@index([ownerId])
  @@map("stores")
}

model StorePage {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pageType  PageType @default(home) @map("page_type")
  slug      String?
  title     String?
  blocks    Json     @default("[]")
  html      String   @default("") @map("html")
  briefJson Json?    @map("brief_json")

  // SEO Fields
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  seoImage       String? @map("seo_image")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@map("store_pages")
}

model StoreSettings {
  id                     String   @id @default(cuid())
  storeId                String   @unique @map("store_id")
  store                  Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  whatsappNumber         String?  @map("whatsapp_number")
  bankAccounts           Json?    @map("bank_accounts")
  shippingOriginCity     String?  @map("shipping_origin_city")
  shippingOriginProvince String?  @map("shipping_origin_province")
  flatShippingCost       Decimal  @default(0) @map("flat_shipping_cost") @db.Decimal(12, 2)
  midtransServerKey      String?  @map("midtrans_server_key")
  midtransClientKey      String?  @map("midtrans_client_key")
  midtransIsProduction   Boolean  @default(false) @map("midtrans_is_production")
  qrisImageUrl           String?  @map("qris_image_url")
  whatsappApiUrl         String?  @map("whatsapp_api_url")
  whatsappApiKey         String?  @map("whatsapp_api_key")
  whatsappApiKeyHeader   String   @default("Authorization") @map("whatsapp_api_key_header")
  whatsappApiKeyPrefix   String   @default("") @map("whatsapp_api_key_prefix")
  whatsappTargetField    String   @default("target") @map("whatsapp_target_field")
  whatsappMessageField   String   @default("message") @map("whatsapp_message_field")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model Category {
  id        String    @id @default(cuid())
  storeId   String    @map("store_id")
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("categories")
}

model Product {
  id          String          @id @default(cuid())
  storeId     String          @map("store_id")
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  price       Decimal         @db.Decimal(12, 2)
  stock       Int             @default(0)
  categoryId  String?         @map("category_id")
  category    Category?       @relation(fields: [categoryId], references: [id])
  status      ProductStatus   @default(draft)
  variants    ProductVariant[]
  images      ProductImage[]
  orderItems  OrderItem[]

  // SEO Fields
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  seoImage       String? @map("seo_image")

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(cuid())
  productId     String      @map("product_id")
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name          String
  priceOverride Decimal?    @map("price_override") @db.Decimal(12, 2)
  stock         Int         @default(0)
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  order     Int     @default(0)

  @@index([productId])
  @@map("product_images")
}

model Customer {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  email     String?
  address   Json?
  orders    Order[]
  createdAt DateTime @default(now()) @map("created_at")

  @@index([storeId])
  @@map("customers")
}

model Order {
  id                     String      @id @default(cuid())
  storeId                String      @map("store_id")
  store                  Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId             String?     @map("customer_id")
  customer               Customer?   @relation(fields: [customerId], references: [id])
  orderNumber            String      @unique @map("order_number")
  status                 OrderStatus @default(pending)
  subtotal               Decimal     @db.Decimal(12, 2)
  shippingCost           Decimal     @default(0) @map("shipping_cost") @db.Decimal(12, 2)
  total                  Decimal     @db.Decimal(12, 2)
  shippingAddress        Json?       @map("shipping_address")
  paymentMethod          String?     @map("payment_method")
  midtransTransactionId  String?     @map("midtrans_transaction_id")
  items                  OrderItem[]
  payments               Payment[]
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  @@index([storeId])
  @@map("orders")
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String          @map("order_id")
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String          @map("product_id")
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?         @map("variant_id")
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  qty       Int
  price     Decimal         @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id         String    @id @default(cuid())
  orderId    String    @map("order_id")
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String    @default("midtrans")
  status     String
  rawPayload Json?     @map("raw_payload")
  paidAt     DateTime? @map("paid_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([orderId])
  @@map("payments")
}

model AiSettings {
  id        String   @id @default(cuid())
  provider  String?
  baseUrl   String   @map("base_url")
  apiKey    String   @map("api_key")
  model     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_settings")
}

model Article {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  content     String   // HTML or markdown
  excerpt     String?
  thumbnail   String?
  
  // SEO Fields
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  
  status      ProductStatus @default(draft)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([storeId, slug])
  @@index([storeId])
  @@map("articles")
}
